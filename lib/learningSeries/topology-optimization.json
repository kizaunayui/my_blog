  "shared": {
    "models": {
      "two-pump": {
        "variables": ["q", "y"],
        "flowUnit": "L/s",
        "objective": "q^2+2y^2",
        "constraints": ["q+y=6", "0<=q,y<=6"],
        "optimum": {
          "q": 4,
          "y": 2,
          "score": 24
        }
      },
      "four-tank": {
        "flowUnit": "cm^3/s",
        "voltageUnit": "V",
        "heightUnit": "cm",
        "split": [0.7, 0.6],
        "scope": "P028物理模型上的自定义稳态学习任务"
      },
      "four-pump-extension": {
        "variables": ["q_1", "y_1", "q_2", "y_2"],
        "flowUnit": "L/s",
        "objective": "q_1^2+2y_1^2+q_2^2+2y_2^2",
        "constraints": ["q_1+y_1=6", "q_2+y_2=6", "q_1+q_2<=8", "0<=q_m,y_m<=6"],
        "scope": "两个供水模块的四泵教学扩展，下标表示模块，与四水箱出口符号的语境不同"
      }
    },
    "symbols": {
      "q_A,q_B": "两泵同一接口q的本地副本",
      "z": "共同接口估计",
      "u_A,u_B": "缩放对偶量",
      "lambda": "两泵对偶分解的共同价格",
      "theta": "两泵兼容任务改写的教学辅助量",
      "k": "优化轮次",
      "Q_j": "四水箱泵总流量",
      "q_i": "四水箱出口流量",
      "v_j": "四水箱泵输入电压"
    },
